rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CombatMaps currently uses one shared project with no user login.
    // Public access is intentionally restricted to this single project tree.
    match /projects/main {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['version', 'revision', 'keys', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.keys is list
        && request.resource.data.keys.size() <= 400;
      allow delete: if false;

      match /parts/{part} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['json'])
          && request.resource.data.json is string
          && request.resource.data.json.size() <= 400000;
        allow delete: if true;
      }
    }
  }
}
